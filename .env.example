# 複製成 .env 後填入。不要把 .env 或 twitch_token.json 提交到 Git。

# 在 https://dev.twitch.tv/console 建立應用程式，取得 Client ID。
# EventSub WebSocket 必須用「使用者 token」；程式會用 Device Code 開瀏覽器登入。
# OAuth Redirect URL 可填 http://localhost（註冊應用時必填，Device Code 不一定會用到）。
TWITCH_CLIENT_ID=
# 若應用是 confidential 才需要；public client 可留空。
TWITCH_CLIENT_SECRET=

# 要監看的頻道登入名稱，逗號分隔
TWITCH_USER_LOGINS=lanmeinotbeer

# 開台與正片 Discord Incoming Webhook。輔助可空：沒填則兩種都走主網址。
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_START_URL=

# 通知文案（可空＝用預設）。可用 <實況主名稱> <實況主ＩＤ> <實況主網址>，也可直接寫 <@&角色ID>
# DISCORD_LIVE_TEMPLATE=
# DISCORD_START_TEMPLATE=

# 設為 1 時不連 Twitch / FFmpeg，只跑 UI 示範流程
SIMULATE=0

# 畫面抽幀與判定
FRAME_INTERVAL_SEC=3
AD_SKIP_SEC=20
CONFIRM_FRAMES=4
# 開台超過這個分鐘數就不再偵測開頭／正片（0＝不略過）。預設 60。
SKIP_START_AFTER_MIN=60
